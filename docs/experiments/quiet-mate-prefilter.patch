+// MoveGivesCheck tests a legal move without changing the board or its history.
+// Use a private value copy because root search workers can read the same board.
+func (b *Board) MoveGivesCheck(m location.Move) bool {
+	data := b.getPieceData(m.Start)
+	if data == 0 {
+		return false
+	}
+	opponent := data&1 ^ 1
+	kr, kc := b.KingLocations[opponent].Get()
+	sr, sc := m.Start.Get()
+	startRow, startCol := int(sr)-int(kr), int(sc)-int(kc)
+	// Moving a blocker can reveal a slider only along a king ray. For
+	// other starts, reject moves whose destination cannot directly check.
+	if startRow != 0 && startCol != 0 && startRow != startCol && startRow != -startCol {
+		er, ec := m.End.Get()
+		dr, dc := int(kr)-int(er), int(kc)-int(ec)
+		pt := (data & 0xE) >> 1
+		originalType := pt
+		if promotion, promoted := m.End.GetPawnPromotion(); promotion {
+			pt = promoted
+		}
+		possible := false
+		switch pt {
+		case piece.RookType:
+			possible = dr == 0 || dc == 0
+		case piece.BishopType:
+			possible = dr == dc || dr == -dc
+		case piece.QueenType:
+			possible = dr == 0 || dc == 0 || dr == dc || dr == -dc
+		case piece.KnightType:
+			possible = dr*dr+dc*dc == 5
+		case piece.PawnType:
+			possible = dr == 1-2*int(data&1) && (dc == 1 || dc == -1)
+		}
+		// Castling relocates a rook; en passant removes a second blocker.
+		castle := originalType == piece.KingType && (int(sc)-int(ec) == 2 || int(ec)-int(sc) == 2)
+		enPassant := originalType == piece.PawnType && sc != ec && b.getPieceData(m.End) == 0
+		if !possible && !castle && !enPassant {
+			return false
+		}
+	}
+	child := *b
+	child.makeFastMove(&m)
+	if promotion, pt := m.End.GetPawnPromotion(); promotion {
+		child.setPieceData(m.End, pt<<1|data&1)
+	}
+	return child.isKingInCheckFast(child.KingLocations[opponent], opponent)
+}
