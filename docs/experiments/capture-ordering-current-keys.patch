+package board_test
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/Vadman97/GolangChessAI/pkg/chessai/analysis"
+	"github.com/Vadman97/GolangChessAI/pkg/chessai/config"
+	"github.com/Vadman97/GolangChessAI/pkg/chessai/location"
+)
+
+func TestGetAllMovesRanksCapturesByVictimAndAttacker(t *testing.T) {
+	oldRandom := config.Get().RandomMoveOrder
+	config.Get().RandomMoveOrder = false
+	defer func() { config.Get().RandomMoveOrder = oldRandom }()
+	for _, cached := range []bool{false, true} {
+		position, err := analysis.ParseFEN("4k3/6q1/7P/3b4/8/8/1B6/3RK3 w - - 0 1")
+		if err != nil {
+			t.Fatal(err)
+		}
+		position.Board.CacheGetAllMoves = cached
+		original := append([]location.Move(nil), (*position.Board.GetAllMovesUnShuffled(position.Active, position.Previous))...)
+		for repeat := 0; repeat < 2; repeat++ {
+			moves := *position.Board.GetAllMoves(position.Active, position.Previous)
+			// Pawn takes queen, bishop takes queen, then rook takes bishop.
+			for i, want := range []string{"h6g7", "b2g7", "d1d5"} {
+				if got := analysis.MoveToUCI(moves[i]); got != want {
+					t.Fatalf("cache=%v move %d: got %s, want %s", cached, i, got, want)
+				}
+			}
+		}
+		if after := *position.Board.GetAllMovesUnShuffled(position.Active, position.Previous); !reflect.DeepEqual(original, after) {
+			t.Fatalf("cache=%v: ordering mutated the source move list", cached)
+		}
+	}
+}
